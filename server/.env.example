PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27018/norda_db

# Replace with a unique random value of at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_DAYS=7
# Keep false when the client is served by Express. Enable only for a separately
# hosted development client that must use an Authorization header.
AUTH_RETURN_TOKEN=false

# Comma-separated browser origins allowed by CORS.
CLIENT_URL=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
CLIENT_APP_URL=http://localhost:5000
SERVER_URL=http://localhost:5000

# Store pricing
FREE_SHIPPING_THRESHOLD=5000
FLAT_SHIPPING_FEE=120

# Local demo: enabled automatically outside production; set false to disable.
# Demo never charges money and is always disabled when NODE_ENV=production.
# PAYMENT_DEMO_ENABLED=false

# SSLCOMMERZ hosted checkout. Create sandbox credentials at
# https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Admin created by npm run seed. Change this password before sharing a server.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
