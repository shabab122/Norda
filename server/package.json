{
  "name": "norda-commerce-api",
  "version": "2.12.0",
  "description": "Norda commerce API with catalog, payments, fulfillment, reporting and production tools",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/seed.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "test:integration": "node --test --test-concurrency=1 test/mongoIntegration.test.js test/mongoHttp.test.js test/mongoAccount.test.js test/mongoCheckoutRecovery.test.js test/mongoOrderOperations.test.js test/mongoFulfillmentVariants.test.js test/mongoCommerceTools.test.js test/mongoManagement.test.js test/mongoProductionTools.test.js test/mongoBackup.test.js test/mongoReleaseTools.test.js test/mongoOffsiteBackup.test.js",
    "setup": "node scripts/setup-env.js",
    "seed:catalog": "node seed/seed.js --catalog-only",
    "acceptance:preflight": "node scripts/acceptance-preflight.js",
    "mail:check": "node scripts/account-mail.js --check",
    "mail:preview": "node scripts/account-mail.js",
    "reservations:expire": "node scripts/expireReservations.js",
    "mail:orders": "node scripts/account-mail.js --orders",
    "backup:create": "node scripts/backup.js create",
    "backup:verify": "node scripts/backup.js verify",
    "backup:restore": "node scripts/backup.js restore",
    "backup:upload": "node scripts/offsite-backup.js upload",
    "backup:fetch": "node scripts/offsite-backup.js fetch",
    "backup:retention": "node scripts/offsite-backup.js retention",
    "backup:drill": "node scripts/offsite-backup.js drill",
    "monitor:once": "node ../ops/uptime.js --once"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ecommerce",
    "node",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "nodemailer": "10.1.7"
  },
  "nordaCapabilities": [
    "mfa-v1",
    "warehouse-v1",
    "offsite-v1"
  ]
}
