# Install only on an independent host, or configure repository variables/secrets.
NODE_ENV=production
MONITOR_TARGETS_JSON=[{"name":"production","url":"https://shop.example.com/api/health/ready"}]
MONITOR_STATE_FILE=/state/state.json
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_EMAIL=
# If email is used, supply separate monitor SMTP settings; preserve store .env.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
